# Create the Suicide Causal Bayesian Network
# --------------------------------------------------

Suicidebn = gum.BayesNet("Suicide")

BU  = Suicidebn.add(gum.LabelizedVariable("BU",  "Break Up", 2))
RL  = Suicidebn.add(gum.LabelizedVariable("RL",  "Relative Lost", 2))
ES  = Suicidebn.add(gum.LabelizedVariable("ES",  "Emotional Shock", 2))
NFF = Suicidebn.add(gum.LabelizedVariable("NFF", "No Friends & Family", 2))
DEP = Suicidebn.add(gum.LabelizedVariable("DEP", "Depression", 2))
